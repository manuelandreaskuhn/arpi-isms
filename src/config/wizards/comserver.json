{
  "wizard_id": "comserver",
  "label": "Neuer Kommunikationsserver",
  "collection": "comm_servers",
  "uuid_prefix": "commserver_",
  "icon": "comserver",
  "messages": {
    "create_success": "Kommunikationsserver erfolgreich erstellt",
    "update_success": "Kommunikationsserver aktualisiert",
    "delete_success": "Kommunikationsserver gelöscht"
  },
  "pages": [
    {
      "id": "basic",
      "label": "Basis-Informationen",
      "badge": "Pflicht",
      "order": 1,
      "fields": [
        {
          "name": "name",
          "element": "text-name",
          "label": "Name des Kommunikationsservers",
          "required": true
        },
        {
          "name": "type",
          "element": "select-input",
          "label": "Typ / Produkt",
          "required": true,
          "options": [
            {
              "value": "mirth",
              "label": "Mirth Connect"
            },
            {
              "value": "rhapsody",
              "label": "Rhapsody Integration Engine"
            },
            {
              "value": "ensemble",
              "label": "InterSystems Ensemble / HealthShare"
            },
            {
              "value": "cloverleaf",
              "label": "Infor Cloverleaf"
            },
            {
              "value": "interfaceware",
              "label": "Interfaceware Iguana"
            },
            {
              "value": "corepoint",
              "label": "Corepoint Health"
            },
            {
              "value": "qvera",
              "label": "Qvera Interface Engine (QIE)"
            },
            {
              "value": "custom",
              "label": "Eigenentwicklung"
            },
            {
              "value": "other",
              "label": "Sonstige"
            }
          ]
        },
        {
          "name": "vendor",
          "element": "vendor",
          "label": "Hersteller",
          "required": true
        },
        {
          "name": "version",
          "element": "version",
          "label": "Version",
          "required": true
        },
        {
          "name": "criticality",
          "element": "criticality",
          "label": "Kritikalität"
        }
      ]
    },
    {
      "id": "technical",
      "label": "Technische Konfiguration",
      "order": 2,
      "fields": [
        {
          "group": "server-reference",
          "label": "Server-Konfiguration",
          "field_overrides": {
            "serverid": {
              "label": "Server / VM"
            }
          }
        },
        {
          "name": "serveroperatingystem",
          "element": "select-input",
          "label": "Betriebssystem",
          "options": [
            {
              "value": "windows",
              "label": "Windows Server"
            },
            {
              "value": "linux",
              "label": "Linux"
            },
            {
              "value": "unix",
              "label": "Unix"
            },
            {
              "value": "docker",
              "label": "Docker Container"
            },
            {
              "value": "kubernetes",
              "label": "Kubernetes"
            }
          ]
        },
        {
          "name": "commservermanagementurl",
          "element": "management-url",
          "label": "Management-URL"
        },
        {
          "name": "environment",
          "element": "environment",
          "label": "Umgebung"
        }
      ]
    },
    {
      "id": "protocols",
      "label": "Unterstützte Protokolle & Standards",
      "order": 3,
      "fields": [
        {
          "name": "protocols",
          "element": "checkbox-group",
          "label": "Protokoll-Support",
          "options": [
            {
              "value": "hl7v2",
              "label": "HL7 v2.x"
            },
            {
              "value": "fhir",
              "label": "HL7 FHIR"
            },
            {
              "value": "dicom",
              "label": "DICOM"
            },
            {
              "value": "xds",
              "label": "XDS / IHE"
            },
            {
              "value": "rest",
              "label": "REST / HTTP API"
            },
            {
              "value": "soap",
              "label": "SOAP / Web Services"
            },
            {
              "value": "mllp",
              "label": "MLLP (Minimal Lower Layer Protocol)"
            },
            {
              "value": "http",
              "label": "HTTP"
            },
            {
              "value": "tcp",
              "label": "TCP/IP"
            },
            {
              "value": "file",
              "label": "Dateibasiert (File System)"
            },
            {
              "value": "ftp",
              "label": "FTP / SFTP"
            },
            {
              "value": "mq",
              "label": "Message Queue (MQ/AMQP)"
            }
          ]
        }
      ]
    },
    {
      "id": "ha",
      "label": "Hochverfügbarkeit & Performance",
      "order": 4,
      "fields": [
        {
          "name": "serverhighavailability",
          "element": "ha-enabled",
          "label": "HA/Cluster aktiviert"
        },
        {
          "name": "serverclustertype",
          "element": "select-input",
          "label": "Cluster-Typ",
          "condition": {
            "field": "serverhighavailability",
            "operator": "eq",
            "value": true
          },
          "options": [
            {
              "value": "activeactive",
              "label": "Active-Active"
            },
            {
              "value": "activepassive",
              "label": "Active-Passive"
            },
            {
              "value": "loadbalanced",
              "label": "Load Balanced"
            }
          ]
        },
        {
          "name": "servernodecount",
          "element": "number-input",
          "label": "Anzahl Knoten",
          "condition": {
            "field": "serverhighavailability",
            "operator": "eq",
            "value": true
          }
        }
      ]
    },
    {
      "id": "monitoring",
      "label": "Monitoring & Logging",
      "order": 5,
      "fields": [
        {
          "name": "monitoringtool",
          "element": "monitoring-tool",
          "label": "Monitoring-Tool"
        },
        {
          "name": "monitoringlogretention",
          "element": "number-input",
          "label": "Log-Retention (Tage)",
          "placeholder": "z.B. 90"
        },
        {
          "name": "siemserverintegration",
          "element": "toggle",
          "label": "SIEM-Integration aktiviert"
        },
        {
          "name": "siemserverid",
          "element": "siem-reference",
          "label": "SIEM-System",
          "condition": {
            "field": "siemserverintegration",
            "operator": "eq",
            "value": true
          }
        },
        {
          "name": "siemlogformat",
          "element": "select-input",
          "label": "Log-Format",
          "condition": {
            "field": "siemserverintegration",
            "operator": "eq",
            "value": true
          },
          "options": [
            {
              "value": "syslog",
              "label": "Syslog"
            },
            {
              "value": "json",
              "label": "JSON"
            },
            {
              "value": "cef",
              "label": "CEF"
            },
            {
              "value": "leef",
              "label": "LEEF"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
          "name": "siemtransportprotocol",
          "element": "select-input",
          "label": "Transport-Protokoll",
          "condition": {
            "field": "siemserverintegration",
            "operator": "eq",
            "value": true
          },
          "options": [
            {
              "value": "tcp",
              "label": "TCP"
            },
            {
              "value": "udp",
              "label": "UDP"
            },
            {
              "value": "tls",
              "label": "TLS"
            },
            {
              "value": "https",
              "label": "HTTPS"
            },
            {
              "value": "beats",
              "label": "Beats"
            }
          ]
        },
        {
          "name": "siemlogtypes",
          "element": "checkbox-group",
          "label": "Log-Kategorien",
          "condition": {
            "field": "siemserverintegration",
            "operator": "eq",
            "value": true
          },
          "options": [
            {
              "value": "application",
              "label": "Anwendungslogs"
            },
            {
              "value": "security",
              "label": "Sicherheitslogs"
            },
            {
              "value": "access",
              "label": "Zugriffslogs"
            },
            {
              "value": "error",
              "label": "Fehlerlogs"
            },
            {
              "value": "audit",
              "label": "Audit-Logs"
            },
            {
              "value": "performance",
              "label": "Performance-Logs"
            }
          ]
        }
      ]
    },
    {
      "id": "security",
      "label": "Sicherheit & Zugriff",
      "order": 6,
      "fields": [
        {
          "name": "serverauth",
          "element": "select-input",
          "label": "Authentifizierung",
          "options": [
            {
              "value": "ad",
              "label": "Active Directory"
            },
            {
              "value": "ldap",
              "label": "LDAP"
            },
            {
              "value": "local",
              "label": "Lokale Benutzer"
            },
            {
              "value": "sso",
              "label": "Single Sign-On (SSO)"
            },
            {
              "value": "cert",
              "label": "Zertifikatsbasiert"
            }
          ]
        },
        {
          "name": "servertls",
          "element": "select-input",
          "label": "TLS/SSL für Admin-Zugriff",
          "options": [
            {
              "value": "yes",
              "label": "Ja (TLS aktiviert)"
            },
            {
              "value": "no",
              "label": "Nein"
            }
          ]
        },
        {
          "name": "serveraccesspermissions",
          "element": "text-input",
          "label": "Zugriffsberechtigung",
          "placeholder": "z.B. AD-Gruppe, Rollenkonzept"
        }
      ]
    },
    {
      "id": "maintenance",
      "label": "Wartung & Support",
      "order": 7,
      "fields": [
        {
          "name": "servermaintenancewindow",
          "element": "text-input",
          "label": "Wartungsfenster",
          "placeholder": "z.B. Sonntag 02:00-04:00 Uhr"
        },
        {
          "name": "serverlastupdated",
          "element": "date-field",
          "label": "Letztes Update"
        },
        {
          "name": "serversupportcontact",
          "element": "support-contact",
          "label": "Support-Kontakt"
        },
        {
          "name": "notes",
          "element": "notes",
          "label": "Anmerkungen"
        }
      ]
    }
  ],
  "form_id": "newCommServerForm",
  "breadcrumb_label": "Neuen Kommunikationsserver anlegen",
  "breadcrumb_section": "Komponenten",
  "software_data": []
}