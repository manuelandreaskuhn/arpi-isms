{
    "version": "1.0.0",
    "description": "Katalog aller Gruppen-Elemente. Eine Gruppe fasst logisch zusammengehörige Felder als wiederverwendbare Einheit zusammen. Gruppen werden als eigene HTML-Tags gerendert.",
    "groups": [
        {
            "id": "firewall-zones",
            "label": "Netzwerk-Zonen",
            "description": "Standard-Netzwerk-Zonen einer Firewall: External (WAN), Internal (LAN) und DMZ Interface. Diese drei Interfaces bilden die Grundstruktur jeder Netzwerk-Firewall.",
            "html_tag": "isms-firewall-zones",
            "template_file": "partials/elements/groups/firewall-zones.html",
            "fields": [
                {
                    "element_ref": "ip-address",
                    "name": "externalif",
                    "label": "External (WAN) Interface",
                    "placeholder": "z.B. 203.0.113.1 oder eth0"
                },
                {
                    "element_ref": "ip-address",
                    "name": "internalif",
                    "label": "Internal (LAN) Interface",
                    "placeholder": "z.B. 192.168.1.1 oder eth1"
                },
                {
                    "element_ref": "ip-address",
                    "name": "dmzif",
                    "label": "DMZ Interface",
                    "placeholder": "z.B. 172.16.1.1 oder eth2"
                }
            ]
        },
        {
            "id": "dhcp-config",
            "label": "DHCP-Konfiguration",
            "description": "Vollständige DHCP-Einstellungen eines Netzwerks: Aktivierung, Server, Pool-Bereich, Lease-Zeit und statische Reservierungen.",
            "html_tag": "isms-dhcp-config",
            "template_file": "partials/elements/groups/dhcp-config.html",
            "fields": [
                {
                    "element_ref": "select-input",
                    "name": "dhcpenabled",
                    "label": "DHCP aktiviert",
                    "options": [
                        {
                            "value": "yes",
                            "label": "Ja"
                        },
                        {
                            "value": "no",
                            "label": "Nein (statische IPs)"
                        }
                    ]
                },
                {
                    "element_ref": "text-input",
                    "name": "dhcpserver",
                    "label": "DHCP-Server",
                    "placeholder": "IP oder Hostname des DHCP-Servers"
                },
                {
                    "element_ref": "ip-address",
                    "name": "dhcpstart",
                    "label": "DHCP-Pool (Start)",
                    "placeholder": "192.168.1.10"
                },
                {
                    "element_ref": "ip-address",
                    "name": "dhcpend",
                    "label": "DHCP-Pool (Ende)",
                    "placeholder": "192.168.1.254"
                },
                {
                    "element_ref": "text-input",
                    "name": "dhcplease",
                    "label": "DHCP-Lease-Zeit",
                    "placeholder": "z.B. 24h, 1d, 8h"
                },
                {
                    "element_ref": "text-input",
                    "name": "dhcpreservations",
                    "label": "DHCP-Reservierungen",
                    "placeholder": "Feste IP-Zuweisungen nach MAC-Adresse"
                }
            ]
        },
        {
            "id": "siem-integration",
            "label": "SIEM-Integration",
            "description": "Anbindung an ein SIEM-System für zentrales Log-Management und Security Monitoring. Enthält Referenz auf SIEM-Komponente, Log-Format und Transport-Protokoll.",
