                        {
                            "value": "udp",
                            "label": "UDP"
                        },
                        {
                            "value": "tls",
                            "label": "TLS"
                        },
                        {
                            "value": "https",
                            "label": "HTTPS"
                        },
                        {
                            "value": "beats",
                            "label": "Beats"
                        }
                    ]
                }
            ]
        },
